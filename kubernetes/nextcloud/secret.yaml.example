# Ne pas committer le vrai secret. Création directe :
#   kubectl create namespace nextcloud
#   kubectl -n nextcloud create secret generic nextcloud-secrets \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -hex 24)" \
#     --from-literal=REDIS_PASSWORD="$(openssl rand -hex 24)" \
#     --from-literal=NEXTCLOUD_ADMIN_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=OIDC_CLIENT_SECRET="<secret client nextcloud (cf. authelia-oidc)>"
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-secrets
  namespace: nextcloud
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
  REDIS_PASSWORD: CHANGE_ME
  NEXTCLOUD_ADMIN_PASSWORD: CHANGE_ME
  OIDC_CLIENT_SECRET: CHANGE_ME
