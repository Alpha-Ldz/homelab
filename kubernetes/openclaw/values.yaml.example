app-template:
  configMaps:
    config:
      data:
        exec-approvals.json: |
          {
            "version": 1,
            "defaults": {
              "security": "allowlist",
              "ask": "off",
              "autoAllowSkills": true
            }
          }
        openclaw.json: |
          {
            "gateway": {
              "port": 18789,
              "mode": "local",
              "controlUi": {
                "allowedOrigins": ["https://openclaw.example.com", "http://localhost:18789"]
              },
              "auth": {
                "mode": "token",
                "token": "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
              }
            },
            "models": {
              "providers": {
                "ollama": {
                  "baseUrl": "http://ollama.ollama.svc.cluster.local:11434",
                  "apiKey": "ollama-local",
                  "auth": "api-key",
                  "api": "ollama",
                  "models": [
                    {"id": "qwen3:32b-q4_K_M", "name": "Qwen 3 32B (Q4_K_M) - Best for complex tasks"},
                    {"id": "qwen2.5:14b-instruct-q8_0", "name": "Qwen 2.5 14B (Q8) - Best for agents"},
                    {"id": "deepseek-r1:14b-qwen-distill-q8_0", "name": "DeepSeek R1 14B (Q8) - Best reasoning (no tools)"},
                    {"id": "qwen3:14b-q8_0", "name": "Qwen 3 14B (Q8) - Higher quality"},
                    {"id": "qwen2.5-coder:7b-instruct-q8_0", "name": "Qwen 2.5 Coder 7B - Fast coding"},
                    {"id": "llama3.1:8b-instruct-q8_0", "name": "Llama 3.1 8B - General purpose"}
                  ]
                },
                "anthropic": {
                  "baseUrl": "https://api.anthropic.com",
                  "apiKey": "${ANTHROPIC_API_KEY}",
                  "models": [
                    {"id": "claude-sonnet-4-5", "name": "Claude Sonnet 4.5"},
                    {"id": "claude-sonnet-4-6", "name": "Claude Sonnet 4.6"},
                    {"id": "claude-haiku-4-5", "name": "Claude Haiku 4.5"},
                    {"id": "claude-opus-4-6", "name": "Claude Opus 4.6"}
                  ]
                }
              }
            },
            "agents": {
              "defaults": {
                "model": "anthropic/claude-sonnet-4-5"
              }
            },
            "browser": {
              "enabled": true,
              "attachOnly": true,
              "defaultProfile": "remote-vnc",
              "profiles": {
                "remote-vnc": {
                  "cdpUrl": "http://openclaw-chrome-vnc.openclaw.svc.cluster.local:9222",
                  "color": "#FF4500"
                }
              }
            },
            "tools": {
              "profile": "coding",
              "allow": ["*"],
              "exec": {
                "host": "gateway"
              }
            },
            "channels": {
              "telegram": {
                "enabled": true,
                "botToken": "${TELEGRAM_BOT_TOKEN}",
                "dmPolicy": "open",
                "allowFrom": ["*"],
                "streaming": "partial"
              }
            },
            "skills": {
              "entries": {
                "notion-api": {
                  "enabled": true,
                  "env": {
                    "NOTION_KEY": "${NOTION_API_KEY}"
                  }
                },
                "bitwarden-vault": {
                  "enabled": true,
                  "env": {
                    "BITWARDENCLI_APPDATA_DIR": "/home/node/.openclaw/data/bitwarden",
                    "BW_CLIENTID": "${BW_CLIENTID}",
                    "BW_CLIENTSECRET": "${BW_CLIENTSECRET}"
                  }
                }
              }
            }
          }
      enabled: true
  configMode: merge
  controllers:
    main:
      containers:
        chromium:
          enabled: false
        main:
          env:
            TELEGRAM_BOT_TOKEN:
              valueFrom:
                secretKeyRef:
                  key: token
                  name: telegram-bot-token
            NOTION_API_KEY:
              valueFrom:
                secretKeyRef:
                  key: key
                  name: notion-api-key
            NOTION_KEY:
              valueFrom:
                secretKeyRef:
                  key: key
                  name: notion-api-key
            BITWARDENCLI_APPDATA_DIR: "/home/node/.openclaw/data/bitwarden"
            BW_CLIENTID:
              valueFrom:
                secretKeyRef:
                  key: clientid
                  name: bitwarden-api-key
            BW_CLIENTSECRET:
              valueFrom:
                secretKeyRef:
                  key: clientsecret
                  name: bitwarden-api-key
            ANTHROPIC_API_KEY:
              valueFrom:
                secretKeyRef:
                  key: api-key
                  name: anthropic-api-key
            PATH: "/home/node/.openclaw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  ingress:
    main:
      annotations:
        cert-manager.io/cluster-issuer: cloudflare-issuer
        traefik.ingress.kubernetes.io/router.entrypoints: websecure
        traefik.ingress.kubernetes.io/router.tls: "true"
      className: traefik
      enabled: true
      hosts:
      - host: openclaw.example.com
        paths:
        - path: /
          pathType: Prefix
          service:
            identifier: main
            port: http
      tls:
      - hosts:
        - openclaw.example.com
        secretName: openclaw-tls
  nodeSelector:
    kubernetes.io/hostname: sleeper
  openclawVersion: 2026.2.25
  persistence:
    bash-aliases:
      advancedMounts:
        main:
          main:
          - path: /home/node/.bash_aliases
            readOnly: true
            subPath: bash_aliases
      enabled: true
      identifier: config
      type: configMap
    config:
      advancedMounts:
        main:
          init-config:
          - path: /config
            readOnly: true
      enabled: true
      identifier: config
      type: configMap
    data:
      accessMode: ReadWriteOnce
      advancedMounts:
        main:
          init-config:
          - path: /home/node/.openclaw
          init-skills:
          - path: /home/node/.openclaw
          main:
          - path: /home/node/.openclaw
      enabled: true
      size: 10Gi
      storageClass: longhorn
      type: persistentVolumeClaim
    tmp:
      advancedMounts:
        main:
          init-config:
          - path: /tmp
          init-skills:
          - path: /tmp
          main:
          - path: /tmp
      enabled: true
      type: emptyDir
  resources:
    limits:
      cpu: 2000m
      memory: 2Gi
    requests:
      cpu: 500m
      memory: 512Mi
  service:
    main:
      controller: main
      ipFamilies:
      - IPv4
      ipFamilyPolicy: SingleStack
      ports:
        http:
          port: 18789
      type: ClusterIP
  tolerations:
  - effect: NoSchedule
    key: dedicated
    value: llm
