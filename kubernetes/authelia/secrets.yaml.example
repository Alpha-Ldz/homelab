apiVersion: v1
kind: Secret
metadata:
  name: authelia-secrets
  namespace: authelia
type: Opaque
stringData:
  # Generate with: openssl rand -hex 32
  JWT_SECRET: "<GENERATE_WITH_openssl_rand_-hex_32>"
  SESSION_SECRET: "<GENERATE_WITH_openssl_rand_-hex_32>"
  STORAGE_ENCRYPTION_KEY: "<GENERATE_WITH_openssl_rand_-hex_32>"
---
# OIDC (SSO Homarr / Portainer). Clé de signature + HMAC + digests des secrets clients :
#   openssl genrsa -out jwks.pem 4096
#   kubectl -n authelia exec deploy/authelia -- authelia crypto hash generate pbkdf2 --variant sha512 --password '<secret client>'
#   kubectl -n authelia create secret generic authelia-oidc \
#     --from-literal=HMAC_SECRET="$(openssl rand -hex 64)" --from-file=jwks.pem=jwks.pem \
#     --from-literal=HOMARR_CLIENT_SECRET_DIGEST='$pbkdf2-sha512$...' \
#     --from-literal=PORTAINER_CLIENT_SECRET_DIGEST='$pbkdf2-sha512$...'
# Les secrets clients en clair vont côté application :
#   homarr    -> Secret homarr/homarr-oidc (AUTH_OIDC_CLIENT_SECRET)
#   portainer -> Settings > Authentication > OAuth (saisi dans l'UI)
apiVersion: v1
kind: Secret
metadata:
  name: authelia-oidc
  namespace: authelia
type: Opaque
stringData:
  HMAC_SECRET: "<openssl rand -hex 64>"
  HOMARR_CLIENT_SECRET_DIGEST: "<$pbkdf2-sha512$...>"
  PORTAINER_CLIENT_SECRET_DIGEST: "<$pbkdf2-sha512$...>"
  jwks.pem: |
    <clé RSA privée PEM>
