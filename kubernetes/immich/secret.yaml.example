# Ne pas committer le vrai secret. Création directe :
#   kubectl create namespace immich
#   kubectl -n immich create secret generic immich-secrets \
#     --from-literal=DB_PASSWORD="$(openssl rand -hex 24)"
# (le secret client OAuth se saisit dans l'UI Immich, cf. authelia-oidc)
apiVersion: v1
kind: Secret
metadata:
  name: immich-secrets
  namespace: immich
type: Opaque
stringData:
  DB_PASSWORD: CHANGE_ME
