# Ne pas committer les vrais secrets. Le plus simple est de les créer directement :
#   kubectl -n homarr create secret generic homarr-oidc --from-literal=AUTH_OIDC_CLIENT_SECRET=<secret client homarr>
#   kubectl create namespace homarr
#   kubectl -n homarr create secret generic homarr-secrets \
#     --from-literal=SECRET_ENCRYPTION_KEY="$(openssl rand -hex 32)"
# Conserver la clé (ex. dans pass/Vaultwarden) : sans elle, les identifiants
# d'intégrations chiffrés dans la base Homarr sont illisibles.
apiVersion: v1
kind: Secret
metadata:
  name: homarr-secrets
  namespace: homarr
type: Opaque
stringData:
  SECRET_ENCRYPTION_KEY: CHANGE_ME # 64 caractères hexadécimaux (openssl rand -hex 32)
