# Ne pas committer. ⚠️ Sans ce mot de passe, les sauvegardes sont illisibles :
# le conserver aussi HORS du Pi (gestionnaire de mots de passe).
#   kubectl create namespace backup
#   kubectl -n backup create secret generic backrest-secrets \
#     --from-literal=RESTIC_PASSWORD="$(openssl rand -hex 32)"
apiVersion: v1
kind: Secret
metadata:
  name: backrest-secrets
  namespace: backup
type: Opaque
stringData:
  RESTIC_PASSWORD: CHANGE_ME
